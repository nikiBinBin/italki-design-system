      "coverageStatus": "mapped",
      "pandaComponent": "Button",
      "preferredImport": "@repo/components/ui",
      "source": "@italki/panda ButtonProps",
      "notes": "Use the product wrapper. Catalog variants are not a second Button API; resolve the variant through this map before implementation.",
      "props": {
        "label": {
          "status": "direct",
          "pandaProp": "children",
          "notes": "Pass the visible button label as children."
        },
        "variant": {
          "status": "adapter",
          "pandaProp": "type | text | outlined | special | ghost | danger",
          "notes": "Map each Catalog variant through the approved product convention. Confirm ghost, danger, plus, and emphasis visuals before use; do not infer them from another library."
        },
        "size": {
          "status": "adapter",
          "pandaProp": "size",
          "notes": "Panda uses semantic sizes rather than Catalog pixel values. The application adapter owns the 32/40/48 mapping."
        },
        "shape": {
          "status": "adapter",
          "pandaProp": "shape",
          "notes": "Panda supports default, circle, and round. Resolve Catalog rounded and pill values through the product wrapper."
        },
        "state": {
          "status": "catalog-only",
          "pandaProp": null,
          "notes": "The Catalog fixture displays interaction states; Panda derives them from behavior and props."
        },
        "leadingIcon": {
          "status": "direct",
          "pandaProp": "icon",
          "notes": "Panda Button renders its icon before children."
        },
        "trailingIcon": {
          "status": "adapter",
          "pandaProp": "children composition",
          "notes": "Panda has no dedicated trailing-icon prop. Use an approved content composition without changing Button anatomy."
        },
        "iconOnly": {
          "status": "adapter",
          "pandaProp": "icon + aria-label",
          "notes": "Use the Panda icon path with an accessible name; this is not an independent Boolean Panda prop."
        },
        "disabled": {
          "status": "direct",
          "pandaProp": "disabled",
          "notes": "Use Panda disabled behavior."
        },
        "loading": {
          "status": "direct",
          "pandaProp": "loading",
          "notes": "Use Panda loading behavior."
        },
        "demo": {
          "status": "catalog-only",
          "pandaProp": null,
          "notes": "Fixture identifier only."
        },
        "ariaLabel": {
          "status": "direct",
          "pandaProp": "aria-label",
          "notes": "Native ARIA attribute forwarded by Button."
        },
        "href": {
          "status": "direct",
          "pandaProp": "href",
          "notes": "Panda renders the supported link form."
        },
        "download": {
          "status": "direct",
          "pandaProp": "download",
          "notes": "Native anchor attribute supported by the link form."
        },
        "target": {
          "status": "direct",
          "pandaProp": "target",
          "notes": "Native anchor attribute supported by the link form."
