{
  "schemaVersion": 1,
  "sourceOfTruth": [
    "catalog-runtime/contracts.json",
    "@italki/panda component prop types",
    "existing project wrappers"
  ],
  "statusDefinitions": {
    "direct": "The Catalog prop has a confirmed Panda prop or native attribute destination.",
    "adapter": "The value is supported only through a documented Panda composition or product adapter.",
    "catalog-only": "The prop controls a Catalog fixture or example state and must not be copied into production code.",
    "gap": "No confirmed Panda API safely represents this Catalog prop. Report the gap instead of styling around it."
  },
