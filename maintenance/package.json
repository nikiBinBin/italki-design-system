{
  "name": "italki-catalog-runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build:contracts": "node scripts/build-contract-runtime.mjs",
    "build:api": "node scripts/generate-component-api.mjs",
    "component:check": "node scripts/check-component.mjs",
    "serve:catalog": "node scripts/serve-catalog.mjs",
    "intake": "node kit-source/intake/intake.mjs",
    "test:intake": "node kit-source/intake/intake.mjs --selftest",
    "test:contract": "npm run build:contracts && npm run build:api && npm run build:icons && npm run build:images && node scripts/validate-contracts.mjs && npm run lint:foundation && npm run lint:type && npm run test:intake && npm run lint:enforcement",
    "pretest:visual": "npm run build:contracts",
    "test:visual": "playwright test",
    "test": "npm run test:contract && npm run audit:coverage && npm run test:visual",
    "lint:foundation": "node scripts/lint-foundation.mjs",
    "build:icons": "node scripts/build-icon-manifest.mjs",
    "build:images": "node scripts/build-image-manifest.mjs",
    "build:ds": "node scripts/build-ds-project.mjs && node scripts/build-ds-cards.mjs",
    "kit": "node scripts/build-agent-kit.mjs --zip",
    "audit:ds": "node scripts/audit-ds-cards.mjs .. ds-project",
    "lint:type": "node scripts/migrate-type-tokens.mjs --check",
    "build:covers": "node scripts/build-cover-assets.mjs",
    "audit:shell": "node scripts/audit-shell.mjs",
    "audit:hooks": "node scripts/audit-hooks.mjs",
    "audit:templates": "node scripts/audit-templates.mjs",
    "serve:templates": "node scripts/serve-templates.mjs",
    "audit:adherence": "node scripts/audit-adherence.mjs",
    "audit:coverage": "node scripts/audit-coverage.mjs",
    "check:intake": "node kit-source/intake/check-intake.mjs",
    "lint:enforcement": "node --check kit-source/intake/check-intake.mjs && node --check kit-source/intake/intake-gate.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
